# ═══════════════════════════════════════════════════════════
#  إعدادات جسر تيرادينغ فيو ← ميتاتريدر
#  انسخ هذا الملف باسم .env ثم املأه. ولا ترفع .env إلى غيت أبداً.
# ═══════════════════════════════════════════════════════════

# ── كلمة سر الويب هوك ──
# تُكتب داخل رسالة التنبيه، وبدونها تُرفض كل رسالة تصل.
# ولّدها بأمر:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# ── مفتاح الأمان ──
# true: كل شيء يعمل ويُسجَّل ولا تُفتح صفقة حقيقية. ابدأ به دائماً.
DRY_RUN=true
# false: يوقف البريدج كله دون إطفائه
ENABLED=true

# ── الخادم ──
# تيرادينغ فيو لا ترسل إلا إلى المنفذ 80 أو 443
HOST=0.0.0.0
PORT=80
WEBHOOK_PATH=/webhook

# ── حساب الميتاتريدر ٥ ──
# تُملأ عند إطفاء DRY_RUN فقط. مثال من حساب XM التجريبي:
#   MT5_LOGIN=169411598
#   MT5_SERVER=XMGlobalMU-MT5 2
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# مسار terminal64.exe إن لم يجده البريدج وحده، مثال:
# MT5_PATH=C:\Program Files\XM Global MT5\terminal64.exe
MT5_PATH=

# ── الرمز ──
# اسم الذهب عند الوسيط كما يظهر في نافذة Market Watch.
# عند XM هو GOLD لا XAUUSD. وعند غيره قد يكون XAUUSD أو XAUUSD.m
# أو سواهما — تأكّد منه بعينك في البرنامج قبل أي شيء.
SYMBOL=GOLD
# ما ترسله تيرادينغ فيو ← ما يقابله عند الوسيط.
# شارتك يرسل OANDA:XAUUSD، والوسيط يسمّيه GOLD، فهذا سطر الترجمة.
SYMBOL_MAP=XAUUSD=GOLD

# ── حجم الصفقة ──
LOT=0.01
# نسبة مخاطرة من الرصيد بدل اللوت الثابت. صفر يعني: الزم LOT.
RISK_PERCENT=0
MAX_LOT=1.0

# ── حدود الأمان ──
MAX_OPEN_POSITIONS=1
# أكبر خسارة تُقبل في صفقة واحدة بالدولار
MAX_RISK_USD=50
# حدود مسافة الوقف بسعر الذهب (دولارات للأونصة)
MIN_STOP_DISTANCE=0.5
MAX_STOP_DISTANCE=100
SLIPPAGE_POINTS=30
MAGIC=26092101

# ── إدارة الصفقة بعد فتحها ──
# أي هدف يوضع للصفقة عند الوسيط: 1 أو 2 أو 3
TARGET_TP=1
# عند بلوغ الهدف الأول: كم بالمئة يُغلق من الصفقة (صفر: لا شيء)
TP1_CLOSE_PERCENT=0
# وهل يُنقل الوقف إلى سعر الدخول
TP1_MOVE_TO_BREAKEVEN=true
# إشارة معاكسة وصفقة مفتوحة: تُغلق القديمة ثم تُفتح الجديدة
REVERSE_ON_OPPOSITE=true

# ── حارس الصمت ──
# تنبيهات تيرادينغ فيو على خطة Essential تنتهي بعد شهرين، فتسكت
# القناة ويبقى البريدج ينصت وأنت تحسبه يتداول. هذه المدة التي إن
# مرّت بلا تنبيه واحد **والسوق يتحرك** أرسل لك إشعاراً. صفر يُطفئه.
# ويحتاج تيليغرام أدناه، وإلا اكتفى بالسجل.
SILENCE_HOURS=48
# كم ينتظر قبل أن يعيد التنبيه ما دام الصمت قائماً
SILENCE_REPEAT_HOURS=24
SILENCE_CHECK_MINUTES=15
# أسعار الوسيط متجمدة هذه المدة ⇒ السوق مقفل، فالصمت طبيعي لا يُنبَّه
STALE_QUOTE_MINUTES=10

# ── إشعار تيليغرام (اختياري) ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

LOG_FILE=bridge.log
