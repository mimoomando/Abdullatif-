# ═══════════════════════════════════════════════════════════
#  إعدادات جسر تيرادينغ فيو ← ميتاتريدر
#  انسخ هذا الملف باسم .env ثم املأه. ولا ترفع .env إلى غيت أبداً.
# ═══════════════════════════════════════════════════════════

# ── كلمة سر الويب هوك ──
# تُكتب داخل رسالة التنبيه، وبدونها تُرفض كل رسالة تصل.
# ولّدها بأمر:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# ── مفتاح الأمان ──
# true: كل شيء يعمل ويُسجَّل ولا تُفتح صفقة حقيقية. ابدأ به دائماً.
DRY_RUN=true
# false: يوقف البريدج كله دون إطفائه
ENABLED=true

# ── الخادم ──
# تيرادينغ فيو لا ترسل إلا إلى المنفذ 80 أو 443
HOST=0.0.0.0
PORT=80
WEBHOOK_PATH=/webhook

# ── حساب جست ماركتس في الميتاتريدر ٥ ──
# تُملأ عند إطفاء DRY_RUN فقط
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# مسار terminal64.exe إن لم يجده البريدج وحده، مثال:
# MT5_PATH=C:\Program Files\JustMarkets MT5 Terminal\terminal64.exe
MT5_PATH=

# ── الرمز ──
# اسم الذهب عند جست ماركتس كما يظهر في Market Watch.
# قد يكون XAUUSD أو XAUUSD.m أو غيرهما — تأكّد منه بعينك.
SYMBOL=XAUUSD
# ما ترسله تيرادينغ فيو ← ما يقابله عند الوسيط
SYMBOL_MAP=XAUUSD=XAUUSD

# ── حجم الصفقة ──
LOT=0.01
# نسبة مخاطرة من الرصيد بدل اللوت الثابت. صفر يعني: الزم LOT.
RISK_PERCENT=0
MAX_LOT=1.0

# ── حدود الأمان ──
MAX_OPEN_POSITIONS=1
# أكبر خسارة تُقبل في صفقة واحدة بالدولار
MAX_RISK_USD=50
# حدود مسافة الوقف بسعر الذهب (دولارات للأونصة)
MIN_STOP_DISTANCE=0.5
MAX_STOP_DISTANCE=100
SLIPPAGE_POINTS=30
MAGIC=26092101

# ── إدارة الصفقة بعد فتحها ──
# أي هدف يوضع للصفقة عند الوسيط: 1 أو 2 أو 3
TARGET_TP=1
# عند بلوغ الهدف الأول: كم بالمئة يُغلق من الصفقة (صفر: لا شيء)
TP1_CLOSE_PERCENT=0
# وهل يُنقل الوقف إلى سعر الدخول
TP1_MOVE_TO_BREAKEVEN=true
# إشارة معاكسة وصفقة مفتوحة: تُغلق القديمة ثم تُفتح الجديدة
REVERSE_ON_OPPOSITE=true

# ── إشعار تيليغرام (اختياري) ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

LOG_FILE=bridge.log
